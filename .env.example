# Copia este archivo como .env y llena los valores de Supabase:
# Project Settings -> API (o "Connect") en supabase.com
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# La clave publica: "anon public" o "publishable" (sb_publishable_...).
# NUNCA pongas aqui la service_role / secret key.
VITE_SUPABASE_ANON_KEY=
